{
    "name": "webware/webware-mailer",
    "description": "Php Mail abstraction for a variety of php mailer libraries for mezzio applications",
    "license": "BSD-3-Clause",
    "keywords": [
        "webware",
        "mezzio",
        "php mail",
        "MailerInterface abstraction for mezzio applications"
    ],
    "homepage": "https://github.com/orgs/webinertia/discussions",
    "support": {
        "issues": "https://github.com/webinertia/webware-mailer/issues",
        "chat": "https://discord.gg/9TxQ74EPsG"
    },
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net"
        }
    ],
    "require": {
        "php": "~8.4.1 || ~8.5.0",
        "phpmailer/phpmailer": "^7.0.0"
    },
    "require-dev": {
        "infection/infection": "^0.34.1",
        "laminas/laminas-servicemanager": "^4.0.0",
        "phpbench/phpbench": "^1.7",
        "phpunit/phpunit": "^13.3.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "roave/backward-compatibility-check": "^8.21.0",
        "roave/security-advisories": "dev-master",
        "webware/message-bus": "2.0.x-dev",
        "webware/messagebus-event": "^2.0.0-beta.1",
        "webware/webware-tools": "^0.1.x-dev"
    },
    "extra": {
        "laminas": {
            "config-provider": "Webware\\Mailer\\ConfigProvider"
        }
    },
    "autoload": {
        "psr-4": {
            "Webware\\Mailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebwareTest\\Mailer\\": "test/unit/",
            "WebwareTestIntegration\\Mailer\\": "test/integration/"
        }
    },
    "scripts": {
        "test-all": [
            "@test",
            "@test-integration"
        ],
        "test": "phpunit --no-coverage --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml --coverage-html coverage/html --coverage-text",
        "test-integration": "phpunit --no-coverage --colors=always --testsuite \"integration test\"",
        "mutation-test": "infection"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        },
        "allow-plugins": {
            "laminas/laminas-component-installer": true,
            "composer/package-versions-deprecated": true,
            "infection/extension-installer": true
        }
    }
}
